# Copy to .env and replace both values before starting Docker Compose.
POSTGRES_DB=fieldnotes
POSTGRES_USER=fieldnotes
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=5432
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=8080
CORS_ORIGINS=*

# Gmail SMTP for password reset; keep the app password private in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Expo mobile app settings. For a physical phone, replace localhost with this PC's private LAN IP.
# Local HTTP is supported only for local/private endpoints; use HTTPS for public APIs.
# The Android/iOS development build must be regenerated if the API URL protocol changes.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Optional: required for Google Maps tiles in Android development builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
